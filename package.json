{
  "name": "sesh",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant calendar scheduling platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace @sesh/api",
    "dev:web": "npm run dev --workspace @sesh/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace @sesh/api",
    "db:studio": "npm run db:studio --workspace @sesh/api"
  }
}
