# Copy to apps/api/.env and adjust as needed.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Dev Postgres from docker-compose.yml (host port 5544).
DATABASE_URL=postgresql://sesh:sesh@localhost:5544/sesh

# Comma-separated allowed origins for CORS (the web app), or * for any.
WEB_ORIGIN=http://localhost:5173

# Auth. In dev, set DEV_AUTH=true to bypass Clerk and authenticate via the
# `x-dev-clerk-user` header (value = a User.clerkUserId). For production set
# DEV_AUTH=false and provide CLERK_SECRET_KEY.
DEV_AUTH=true
# CLERK_SECRET_KEY=sk_test_xxx
