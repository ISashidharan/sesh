# Copy to apps/web/.env
VITE_API_URL=http://localhost:4000

# Clerk (B2B auth). Leave unset for local dev: the app runs in dev-auth mode and
# sends the `x-dev-clerk-user` header instead of a Bearer token. Set this to your
# Clerk publishable key to enable real sign-in (the admin app then requires a
# signed-in session). Pair with DEV_AUTH=false + CLERK_SECRET_KEY on the API.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
